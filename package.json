{
  "name": "twirly",
  "productName": "Twirly",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Radial file action launcher for Windows",
  "author": "Mark",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "helper:build": "dotnet publish native/windows-helper/TwirlyHelper.csproj -c Release -o native/windows-helper/bin/publish",
    "dist": "npm run build && npm run helper:build && npm run ffmpeg:fetch && electron-builder --win",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "dist:dir": "npm run build && npm run helper:build && npm run ffmpeg:fetch && electron-builder --win --dir"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "license": "MIT"
}
